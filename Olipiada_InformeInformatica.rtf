\pard\li283\ri283\sa100\sl240\slmult1\cf6\b0\f7\fs17 SELECT e.nombre AS equipo, c.nombre AS categoria,\line p.nombre, p.apellido, pr.fecha_prestamo,\line pr.fecha_prevista_devolucion\line FROM prestamos pr\line INNER JOIN equipos e ON pr.id_equipo = e.id_equipo\line INNER JOIN categorias c ON e.id_categoria = c.id_categoria\line INNER JOIN personas p ON pr.id_persona = p.id_persona\line LEFT JOIN devoluciones d ON pr.id_prestamo = d.id_prestamo\line WHERE d.id_devolucion IS NULL;\par

\pard\sa120\sl269\slmult0\cf0\b\f1\fs21 Historial de pr\'e9stamos de una persona:\par

\pard\li283\ri283\sa100\sl240\slmult1\cf6\b0\f7\fs17 SELECT p.nombre, p.apellido, e.nombre AS equipo,\line c.nombre AS categoria, pr.fecha_prestamo,\line pr.fecha_prevista_devolucion, d.fecha_devolucion\line FROM personas p\line INNER JOIN prestamos pr ON p.id_persona = pr.id_persona\line INNER JOIN equipos e ON pr.id_equipo = e.id_equipo\line INNER JOIN categorias c ON e.id_categoria = c.id_categoria\line LEFT JOIN devoluciones d ON pr.id_prestamo = d.id_prestamo\line WHERE p.id_persona = 1;\par

\pard\sa120\sl269\slmult0\cf0\b\f1\fs21 Equipos disponibles:\b0\par

\pard\li283\ri283\sa100\sl240\slmult1\cf6\f7\fs17 SELECT e.nombre AS equipo, c.nombre AS categoria,\line e.marca, e.modelo\line FROM equipos e\line INNER JOIN categorias c ON e.id_categoria = c.id_categoria\line WHERE e.estado = 'Disponible';\par

\pard\sa120\sl269\slmult0\cf0\b\f1\fs21 Cantidad por categor\'eda:\par

\pard\li283\ri283\sa100\sl240\slmult1\cf6\b0\f7\fs17 SELECT c.nombre AS categoria,\line COUNT(e.id_equipo) AS cantidad_equipos\line FROM categorias c\line LEFT JOIN equipos e ON c.id_categoria = e.id_categoria\line GROUP BY c.id_categoria, c.nombre;\par

\pard\sa120\sl269\slmult0\cf0\b\f1\fs21 Pr\'e9stamos vencidos:\b0\par

\pard\li283\ri283\sa100\sl240\slmult1\cf6\f7\fs17 SELECT p.nombre, p.apellido, e.nombre AS equipo,\line pr.fecha_prevista_devolucion\line FROM prestamos pr\line INNER JOIN personas p ON pr.id_persona = p.id_persona\line INNER JOIN equipos e ON pr.id_equipo = e.id_equipo\line LEFT JOIN devoluciones d ON pr.id_prestamo = d.id_prestamo\line WHERE d.id_devolucion IS NULL\line AND pr.fecha_prevista_devolucion < CURDATE();\par

\pard\keep\keepn\sb160\sa80\sl269\slmult0\cf3\b\f3\fs28 Comparaci\'f3n y justificaci\'f3n\cf4\par

\pard\sa120\sl269\slmult0\cf0\f1\fs21 Frente a una planilla manual, el modelo relacional reduce repetici\'f3n, mejora la integridad de los datos y facilita consultas. Se selecciona este dise\'f1o porque separa claramente personas, categor\'edas, equipos, pr\'e9stamos y devoluciones, y permite conocer el estado actual mediante la relaci\'f3n entre pr\'e9stamos y devoluciones.\par

\pard\keep\keepn\sb200\sa120\sl269\slmult0\cf3\f3\fs36 6. Sistema de reservas de espacios escolares\cf1\par

\pard\keep\keepn\sb160\sa80\sl269\slmult0\cf3\fs28 Descripci\'f3n y objetivo\cf4\par

\pard\sa120\sl269\slmult0\cf0\f1\fs21 Es una aplicaci\'f3n web para gestionar reservas de cuatro espacios comunes: Laboratorio de inform\'e1tica, Biblioteca, SUM y Sala multimedia. Cada docente inicia sesi\'f3n, elige un espacio, indica fecha y horario y el sistema evita superposiciones.\b0\par

